# Seva Connect Backend environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Port the Express server listens on
PORT=5000

# Environment: "development" locally, "production" when deployed.
NODE_ENV=development

# MongoDB Atlas connection string (database name: sevaconnect)
# Example: mongodb+srv://<dbUser>:<dbPassword>@cluster0.ab12c.mongodb.net/sevaconnect?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# Secret used to sign & verify JWT tokens (use a long random string)
JWT_SECRET=your_secure_jwt_secret

# Comma-separated list of allowed browser origins.
# In production this MUST include the real frontend origin(s), e.g.
#   CLIENT_URL=https://seva-connect-eta.vercel.app
# When unset, localhost development origins plus the known Vercel deployment
# are allowed; arbitrary origins are never reflected.
CLIENT_URL=http://localhost:5173

# Optional: JWT lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# Seva AI chatbot — Google Gemini API key from https://aistudio.google.com/apikey
# Leave unset and the chatbot still answers, using a local data-driven assistant.
GEMINI_API_KEY=your_gemini_api_key

# Optional: override the Gemini model used by the chatbot.
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Transactional email (required for registration OTP and password resets)
# ---------------------------------------------------------------------------
# Registration cannot complete until SMTP is configured and the OTP can be
# delivered. Use an app password / API key, never your account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
# Set explicitly if your provider needs implicit TLS (port 465 does this by default)
# SMTP_SECURE=false
MAIL_FROM="Seva Connect <no-reply@sevaconnect.org>"

# Optional: separate secret used to HMAC OTP digests.
# Defaults to JWT_SECRET when unset. Set a distinct long random value in production.
# OTP_PEPPER=another_long_random_string

# Optional OTP policy overrides (defaults shown)
# OTP_TTL_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5

# Test-only: a fixed six-digit code accepted when NODE_ENV=test.
# Never set this in production.
# OTP_TEST_CODE=
