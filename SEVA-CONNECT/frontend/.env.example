# Backend API base URL used by the frontend.
# Default "/api" is proxied by Vite to http://localhost:5000 in development.
# For production (Vercel), set this to your deployed Render API — otherwise
# /api calls resolve to the Vercel origin and break. Example:
# VITE_API_URL=https://seva-connect-api.onrender.com/api
VITE_API_URL=/api