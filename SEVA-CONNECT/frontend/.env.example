# Backend API base URL used by the frontend.
# Default "/api" is proxied by Vite to http://localhost:5000 in development.
# For production (Vercel), set this to your deployed Render API — otherwise
# /api calls resolve to the Vercel origin and break. Example:
# VITE_API_URL=https://seva-connect-api.onrender.com/api
VITE_API_URL=/api

# Google Identity Services client ID (public — safe to expose in the browser).
# Create it in Google Cloud Console > APIs & Services > Credentials >
# "OAuth client ID" > Application type: Web application.
# Add every frontend origin under "Authorized JavaScript origins":
#   http://localhost:5173
#   https://<your-vercel-app>.vercel.app
# No client secret is used by the ID-token flow and none is needed here.
# Leave empty to hide/disable the Google button.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
